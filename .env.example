# From the Clerk dashboard for the instance core-api is configured against.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Must match Clerk Native applications → Allowlist for mobile SSO redirect.
EXPO_PUBLIC_CLERK_OAUTH_REDIRECT_URL=

# Your machine's LAN address, NOT localhost — a phone or simulator resolves
# localhost to itself, not to the host running Core API. Include the port.
EXPO_PUBLIC_CORE_API_URL=